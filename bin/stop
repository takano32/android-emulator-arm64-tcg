#!/usr/bin/env bash
#
# エミュレータを停止する。
# まずエミュレータのコンソールに kill を送り、終了しなければシグナルで止める。

source "$(dirname -- "${BASH_SOURCE[0]}")/../lib/common.sh"

if [ $# -gt 0 ]; then
  case "$1" in
    -h|--help) sed -n '3,4s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) die "不明な引数: $1" ;;
  esac
fi

# コンソール (telnet 形式) に接続して kill を送る。`adb emu kill` と同じ操作だが、
# 認証トークンがサンドボックス内の $HOME (var/home) にあるため自前で送る。
console_kill() {
  local token=""
  if [ -r "$CONSOLE_TOKEN_FILE" ]; then token="$(<"$CONSOLE_TOKEN_FILE")"; fi
  (
    exec 3<>"/dev/tcp/127.0.0.1/$EMU_CONSOLE_PORT"
    if [ -n "$token" ]; then printf 'auth %s\r\n' "$token" >&3; fi
    printf 'kill\r\n' >&3
    timeout 5 cat <&3
  ) >/dev/null 2>&1
}

if ! pid="$(emu_pid)"; then
  if port_in_use "$EMU_CONSOLE_PORT"; then
    log "PID ファイルが見つかりませんがポート $EMU_CONSOLE_PORT のエミュレータを停止します"
    console_kill || true
    deadline=$((SECONDS + 30))
    while port_in_use "$EMU_CONSOLE_PORT"; do
      [ "$SECONDS" -lt "$deadline" ] || die "ポート $EMU_CONSOLE_PORT のエミュレータを停止できませんでした"
      sleep 1
    done
    rm -f "$PID_FILE"
    log "停止しました"
    exit 0
  fi
  log "エミュレータは起動していません"
  rm -f "$PID_FILE"
  exit 0
fi

# wait_gone 秒数 : 指定秒数以内にプロセスが消えたら成功
wait_gone() {
  local deadline=$((SECONDS + $1))
  while emu_pid >/dev/null; do
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 1
  done
}

log "エミュレータを停止します (pid $pid)"
console_kill || true
# スナップショット有効時は終了時に RAM 状態を保存するため 120 秒まで待つ
if ! wait_gone 120; then
  log "コンソール経由で終了しなかったため SIGTERM を送ります"
  kill -TERM -- "-$pid" 2>/dev/null || true
  if ! wait_gone 15; then
    log "SIGKILL を送ります"
    kill -KILL -- "-$pid" 2>/dev/null || true
    wait_gone 10 || die "プロセスを停止できませんでした (pid $pid)"
  fi
fi
rm -f "$PID_FILE"
log "停止しました"

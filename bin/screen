#!/usr/bin/env bash
#
# エミュレータの画面をウィンドウに表示し、マウスとキーボードで操作できるようにする。
# エミュレータ本体は画面なしで動かしているので、画面が要るときだけ scrcpy で映す。
# ウィンドウを閉じてもエミュレータは動き続ける。引数はそのまま scrcpy に渡る。
#
#   bin/screen
#   bin/screen --max-fps 5

source "$(dirname -- "${BASH_SOURCE[0]}")/../lib/common.sh"

case "${1:-}" in
  -h|--help) sed -n '3,8s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
esac

need_cmd adb scrcpy
[ "$(adb_state)" = device ] ||
  die "エミュレータが adb に認識されていません。先に bin/start を実行してください"

# scrcpy はゲスト内で画面を動画に圧縮して送る。起動途中のゲストにその負荷をかけると
# 起動がさらに遅れるので、起動完了を待ってからにする。
booted="$(timeout 30 adb -s "$EMU_SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" || true
[ "$booted" = 1 ] ||
  die "Android がまだ起動処理中です。bin/start --wait-boot で起動完了を待ってから実行してください"

# 音声は使わない（エミュレータを -no-audio で起動している）。
# scrcpy は仕様上ゲスト側 MediaCodec (ソフトウェア H.264 エンコーダ) を通すため、
# ローカル接続ではビットレート制限による再量子化負荷をかけず、フレームレートを抑えてエンコード負荷を下げる。
# 後ろに書いた引数が優先されるので、bin/screen --max-fps 15 のように上書きできる。
exec scrcpy --serial "$EMU_SERIAL" --no-audio --max-fps 5 \
  --window-title "$AVD_NAME ($EMU_SERIAL)" "$@"
